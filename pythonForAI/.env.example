# Groq API Configuration
# Get your API key from https://console.groq.com/keys
GROQ_API_KEY="gsk_your_groq_api_key_here"
GROQ_MODEL=llama-3.1-8b-instant

# Blynk IoT Cloud Configuration (Optional: If empty, script runs in Demo/Simulation Mode)
BLYNK_AUTH_TOKEN=p5oV-dojaWL9mde_ZxXfd-LJjunCfr3Y
BLYNK_SERVER=https://blynk.cloud

# Application Settings
POLL_INTERVAL_SECONDS=15
ENABLE_AUTOMATIC_ADVISOR=true

# Python Environment Settings (Prevents creating __pycache__ folders)
PYTHONDONTWRITEBYTECODE=1
